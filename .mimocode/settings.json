{
  "mcpServers": {
    "wechat-mp-mcp": {
      "command": "node",
      "args": ["local-mcps/wechat-mp-nodejs/index.js"],
      "env": {
        "PB_WECHAT_MP_AUTH_KEY": "{env:PB_WECHAT_MP_AUTH_KEY}",
        "PB_WECHAT_MP_API_BASE": "{env:PB_WECHAT_MP_API_BASE}"
      }
    },
    "sensitive-lexicon": {
      "command": "node",
      "args": ["local-mcps/sensitive-lexicon-nodejs/index.js"]
    },
    "image-generation": {
      "url": "{env:PB_IMAGE_GENERATION_URL}",
      "headers": {
        "Authorization": "Bearer {env:PB_MODEL_API_KEY}"
      },
      "timeout": 120000
    },
    "pycorrector": {
      "command": "node",
      "args": ["local-mcps/pycorrector-nodejs/index.js"],
      "env": {
        "PYCORRECTOR_API_URL": "{env:PB_PYCORRECTOR_API_URL}"
      }
    },
    "resend": {
      "command": "node",
      "args": ["local-mcps/resend-nodejs/index.js"],
      "env": {
        "RESEND_API_KEY": "{env:PB_RESEND_API_KEY}"
      }
    }
  }
}
