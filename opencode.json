{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@opencode-ai/plugin"
  ],
  "command": {
    "cmd-wechat-mp-articles": {
      "template": "根据$1抓取微信公众号文章",
      "description": "根据配置文件抓取微信公众号文章并生成汇总报告"
    },
    "cmd-mp-auto-pipeline": {
      "template": "根据$1执行MP自动化管线",
      "description": "从抓取公众号文章到撰写、校对、插图、发送的完整自动化管线"
    },
    "cmd-mp-digest": {
      "template": "根据$1执行MP采集简报管线 (`workflows/workflow_mp-digest.md`)",
      "description": "采集公众号文章并发送汇总报告邮件，不含撰写等后续步骤"
    },
    "cmd-wechat-mp-publish-drafts": {
      "template": "将微信公众号草稿箱内的草稿发布为已发表文章",
      "description": "使用 wechat-mp-wenyan 技能将草稿箱内所有草稿发布为已发表文章（需微信认证开通 freepublish/submit 权限）"
    }
  },
  "permission": {
    "read": { ".env": "allow", "**/.env": "allow", ".env.*": "allow", "**/.env.*": "allow" }
  },
  "skills": {
    "paths": ["skills"]
  },
  "agent": {
    "coordinator": {
      "description": "全流程编排：调用 gatherer 采集 → 调用 commentator 评价主题 → 委托 writer 撰写 → 委托 illustrator 配图 → 发邮件",
      "mode": "all",
      "prompt": "{file:agents/coordinator.md}"
    },
    "writer": {
      "description": "根据主题与素材撰写公众号文章，内部调用 proofreader 完成文字校验循环",
      "mode": "all",
      "prompt": "{file:agents/writer.md}"
    },
    "gatherer": {
      "description": "按需从公众号/网页/文章采集原始信息，输出结构化素材",
      "mode": "all",
      "prompt": "{file:agents/gatherer.md}"
    },
    "illustrator": {
      "description": "根据公众号文章主题绘制配图",
      "mode": "all",
      "prompt": "{file:agents/illustrator.md}"
    },
    "proofreader": {
      "description": "错别字检测 + 敏感词审查 + 语病/标点/语法校验 + 逻辑检查",
      "mode": "subagent",
      "prompt": "{file:agents/proofreader.md}"
    },
    "commentator-value": {
      "description": "从商业与市场视角评价主题的变现潜力与商业价值",
      "mode": "subagent",
      "prompt": "{file:agents/commentator-value.md}"
    },
    "commentator-tech": {
      "description": "从技术创新与工程实现角度评价主题的技术含量",
      "mode": "subagent",
      "prompt": "{file:agents/commentator-tech.md}"
    },
    "commentator-public": {
      "description": "从公众关注度与传播价值角度评价主题的社会影响力",
      "mode": "subagent",
      "prompt": "{file:agents/commentator-public.md}"
    },
    "commentator-academic": {
      "description": "从学术研究与理论价值角度评价主题的学术含金量",
      "mode": "subagent",
      "prompt": "{file:agents/commentator-academic.md}"
    },
    "commentator-ethics": {
      "description": "从伦理合规与社会责任角度评价主题的风险与可持续性",
      "mode": "subagent",
      "prompt": "{file:agents/commentator-ethics.md}"
    },
    "silent": {
      "description": "静默执行模式，禁止提问。仅供 command 内部使用。",
      "mode": "subagent",
      "prompt": "{file:agents/silent.md}",
      "permission": {
        "question": "deny"
      }
    }
  },
  "mcp": {
    "image-generation": {
      "type": "remote",
      "url": "{env:PB_IMAGE_GENERATION_URL}",
      "headers": {
        "Authorization": "Bearer {env:PB_MODEL_API_KEY}"
      },
      "timeout": 120000,
      "enabled": false
    },
    "image-generation-modelscope": {
      "type": "local",
      "command": ["node", "local-mcps/image-generation-modelscope/index.js"],
      "environment": {
        "PB_MODEL_API_KEY": "{env:PB_MODEL_API_KEY}"
      },
      "timeout": 120000,
      "enabled": true
    },
    "image-generation-pollinations": {
      "type": "local",
      "command": ["node", "local-mcps/image-generation-pollinations/index.js"],
      "enabled": true
    },
    "wechat-mp-generation": {
      "type": "local",
      "command": ["node", "local-mcps/wechat-mp-generation/index.js"],
      "environment": {
        "PB_WECHAT_MP_AUTH_KEY": "{env:PB_WECHAT_MP_AUTH_KEY}",
        "PB_WECHAT_MP_API_BASE": "{env:PB_WECHAT_MP_API_BASE}"
      },
      "enabled": true
    },
    "word-sensitive": {
      "type": "local",
      "command": ["node", "local-mcps/word-sensitive/index.js"],
      "enabled": true
    },
    "word-corrector": {
      "type": "local",
      "command": ["node", "local-mcps/word-corrector/index.js"],
      "environment": {
        "PYCORRECTOR_API_URL": "{env:PB_PYCORRECTOR_API_URL}"
      },
      "enabled": true
    },
    "email-resend": {
      "type": "local",
      "command": ["node", "local-mcps/resend-nodejs/index.js"],
      "environment": {
        "RESEND_API_KEY": "{env:PB_RESEND_API_KEY}"
      },
      "enabled": true
    }
  },
  "tui": {
    "todo_indent_width": 4,
    "todo_group_separator": true,
    "todo_status_color": {
      "done": "#4ade80",
      "running": "#facc15",
      "todo": "#9ca3af"
    },
    "conceal_markdown_symbols": false
  }
}
