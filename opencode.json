{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@opencode-ai/plugin"
  ],
  "command": {
    "cmd-wechat-mp-articles": {
      "template": "根据$1抓取微信公众号文章",
      "description": "根据配置文件抓取微信公众号文章并生成汇总报告"
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },
    "wechat-mp-mcp": {
      "type": "local",
      "command": ["node", "local-mcps/wechat-mp-nodejs/index.js"],
      "environment": {
        "PB_WECHAT_MP_AUTH_KEY": "{env:PB_WECHAT_MP_AUTH_KEY}",
        "PB_WECHAT_MP_API_BASE": "{env:PB_WECHAT_MP_API_BASE}"
      },
      "enabled": true
    },
    "sensitive-lexicon": {
      "type": "local",
      "command": ["node", "local-mcps/sensitive-lexicon-nodejs/index.js"],
      "enabled": true
    },
    "image-generation": {
      "type": "remote",
      "url": "{env:PB_IMAGE_GENERATION_URL}",
      "headers": {
        "Authorization": "Bearer {env:PB_MODEL_API_KEY}"
      },
      "timeout": 120000,
      "enabled": true
    },
    "image-generation-pollinations": {
      "type": "local",
      "command": ["node", "local-mcps/image-pollinations-nodejs/index.js"],
      "enabled": true
    },
    "pycorrector": {
      "type": "local",
      "command": ["node", "local-mcps/pycorrector-nodejs/index.js"],
      "environment": {
        "PYCORRECTOR_API_URL": "{env:PB_PYCORRECTOR_API_URL}"
      },
      "enabled": true
    },
    "resend": {
      "type": "local",
      "command": ["node", "local-mcps/resend-nodejs/index.js"],
      "environment": {
        "RESEND_API_KEY": "{env:PB_RESEND_API_KEY}"
      },
      "enabled": true
    }
  }
}
