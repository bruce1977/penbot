{
  "timestamp": "{{timestamp}}",
  "summary": {
    "accounts": {{configured_count}},
    "qualifying_articles": {{qualifying_count}},
    "success_count": {{success_count}},
    "fail_count": {{fail_count}}
  },
  "account_details": [
    {{#accounts}}
    {
      "name": "{{name}}",
      "category": "{{category}}",
      "qualifying_count": {{qualifying_count}},
      "success_count": {{success_count}},
      "fail_count": {{fail_count}},
      "status": "{{status}}"
    }{{^last}},{{/last}}
    {{/accounts}}
  ],
  "articles": [
    {{#articles}}
    {
      "index": {{index}},
      "title": "{{title}}",
      "account_name": "{{account_name}}",
      "file_path": "{{file_path}}",
      "url": "{{url}}"
    }{{^last}},{{/last}}
    {{/articles}}
  ]
  {{#failed}},
  "failed": [
    {{#failed}}
    {
      "type": "{{type}}",
      "account": "{{name}}",
      "articles": [
        {{#articles}}
        {
          "title": "{{title}}",
          "reason": "{{reason}}",
          "url": "{{url}}"
        }{{^last}},{{/last}}
        {{/articles}}
      ]
    }{{^last}},{{/last}}
    {{/failed}}
  ]
  {{/failed}}
}
