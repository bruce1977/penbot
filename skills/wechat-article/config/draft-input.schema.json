{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://penbot.local/schemas/draft-input.schema.json",
  "title": "微信公众号文章 · 初稿输入（Draft Input）",
  "description": "写初稿前必须准备好的三样东西：文章标题、文章大纲、相关资料。draft / bundle 命令读写这个结构。",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "type", "title", "outline", "materials"],
  "properties": {
    "version": { "const": 1, "description": "格式版本，当前固定为 1" },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "文章类型 id（对应 config 里的 types[].id），决定文风、篇幅与评分维度"
    },
    "type_name": { "type": "string", "description": "类型显示名，仅用于阅读，可省略" },
    "created_at": { "type": "string", "description": "ISO 时间戳" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "文章标题（1. 标题）"
    },
    "thesis": { "type": "string", "description": "全文核心判断，一句话，可证伪" },
    "audience": { "type": "string", "description": "目标读者" },
    "hook": { "type": "string", "description": "开篇钩子：一个场景 / 数据 / 冲突" },
    "requirements": { "type": "string", "description": "额外写作要求，来自 --requirements" },
    "length": {
      "type": "object",
      "description": "篇幅区间，缺省时取文章类型的配置",
      "properties": {
        "min": { "type": "integer", "minimum": 200 },
        "target": { "type": "integer", "minimum": 200 },
        "max": { "type": "integer", "minimum": 300 }
      }
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "description": "文章大纲（2. 大纲）：按写作顺序排列的小节",
      "items": {
        "type": "object",
        "required": ["heading"],
        "additionalProperties": true,
        "properties": {
          "heading": { "type": "string", "minLength": 1, "description": "小节标题" },
          "points": {
            "type": "array",
            "description": "这一节要写到的要点，按顺序",
            "items": { "type": "string", "minLength": 1 }
          },
          "target_words": { "type": "integer", "minimum": 0, "description": "该节建议字数" },
          "source_refs": {
            "type": "array",
            "description": "这一节主要依据的素材 id，指向 materials[].id",
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "counterpoint": { "type": "string", "description": "必须回应的反方观点" },
    "takeaway": { "type": "string", "description": "结尾要落到的一句话（读者可带走的结论）" },
    "materials": {
      "type": "array",
      "minItems": 1,
      "description": "相关资料（3. 资料）：整篇文章或若干相关段落",
      "items": {
        "type": "object",
        "required": ["id", "title", "paragraphs"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "素材编号，被 outline[].source_refs 引用"
          },
          "title": { "type": "string", "minLength": 1, "description": "来源标题" },
          "date": { "type": "string", "description": "来源日期 YYYY-MM-DD" },
          "origin": {
            "enum": ["local", "weknora", "manual", "other"],
            "description": "来源渠道：本地目录 / WeKnora / 手工整理"
          },
          "source": { "type": "string", "description": "文件路径或知识库名" },
          "url": { "type": "string", "description": "原文链接（可选）" },
          "summary": { "type": "string", "description": "一句话摘要" },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "description": "相关段落原文；只给段落时也放进这里",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "description": "配图计划（可选；缺省时按类型配置自动规划）",
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "cover": { "type": "boolean", "description": "是否包含封面图" },
        "plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "description"],
            "additionalProperties": true,
            "properties": {
              "position": { "type": "string", "description": "cover 或 inline_1 / inline_2 …" },
              "description": { "type": "string", "description": "中文画面说明" },
              "prompt": { "type": "string", "description": "英文出图提示词" }
            }
          }
        }
      }
    }
  }
}
