{
  "name": "penbot",
  "version": "1.0.0",
  "private": true,
  "description": "Script-driven writing pipelines: wechat-article, micro-news, web-novel.",
  "type": "module",
  "scripts": {
    "wechat-article": "node --env-file=.env scripts/wechat-article.mjs auto",
    "wechat-article:doctor": "node scripts/wechat-article.mjs doctor",
    "wechat-article:validate": "node scripts/wechat-article.mjs validate",
    "pipeline": "node scripts/wechat-article-pipeline.mjs",
    "pipeline:watch": "node scripts/wechat-article-pipeline.mjs --watch",
    "lint": "eslint scripts tests",
    "lint:fix": "eslint scripts tests --fix",
    "check": "npm run lint && npm run wechat-article:validate && npm test",
    "test": "node --test tests/wechat-article/*.test.mjs",
    "test:steps": "node --test tests/wechat-article/steps.test.mjs",
    "test:infra": "node --test tests/wechat-article/infra.test.mjs tests/wechat-article/markdown.test.mjs",
    "test:topic": "node --test tests/wechat-article/topic.test.mjs",
    "test:sources": "node --test tests/wechat-article/sources.test.mjs",
    "test:outline": "node --test tests/wechat-article/outline.test.mjs",
    "test:draft": "node --test tests/wechat-article/draft.test.mjs",
    "test:review": "node --test tests/wechat-article/review.test.mjs",
    "test:compose": "node --test tests/wechat-article/compose.test.mjs",
    "test:publish": "node --test tests/wechat-article/publish.test.mjs"
  },
  "dependencies": {
    "@opencode/cli": "^2.1.4",
    "@opencode/client": "^2.1.1",
    "@wenyan-md/cli": "^2.0.12",
    "markdown-it": "^15.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
